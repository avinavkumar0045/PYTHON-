-0.65 - Income : no of wesite visties
0.78  - spending : catelog purchase
0.68  - spending : store """






from sklearn.preprocessing import OneHotEncoder
df_cleaned.columns


ohe = OneHotEncoder() # no drop first here in clustering, that we do only in Supervised Lerarning

cat_cols = ["Education" , "Living_With"]
# we know that we get the encoded columns alag se
enc_cols = ohe.fit_transform(df_cleaned[cat_cols])


enc_df = pd.DataFrame(enc_cols.toarray() , columns = ohe.get_feature_names_out(cat_cols),index=df_cleaned.index)
# we needed to convert them to array
enc_df.head()


df_encoded = pd.concat([df_cleaned.drop(columns = cat_cols ), enc_df] , axis=1) # remved some and then concatenated


df_encoded.head()





from sklearn.preprocessing import StandardScaler

X = df_encoded

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)





X_scaled.shape


# 2D visulization
from sklearn.decomposition import PCA

pca = PCA(n_components=3) # to visulize in 3D cause in 18D we cant visulize right

X_pca = pca.fit_transform(X_scaled)

pca.explained_variance_ratio_


# plot 🌟🌟🌟🌟🌟🌟 as we will see to projet in 3D
fig = plt.figure(figsize=(8,6))

ax = fig.add_subplot(111, projection="3d")

ax.scatter( X_pca[:,0] , X_pca[:,1] , X_pca[:,2])

ax.set_xlabel("PCA1")
ax.set_ylabel("PCA2")
ax.set_zlabel("PCA3")
ax.set_title("3D projection")






from sklearn.cluster import KMeans
from kneed import KneeLocator

wcss=[]
for k in range(1,11):
    kmeans = KMeans(n_clusters=k , random_state=42)
    kmeans.fit_predict(X_pca)
    wcss.append(kmeans.inertia_)
    


knee = KneeLocator(range(1,11) , wcss , curve="convex", direction="decreasing")
optimal_k = knee.elbow


print("best k : " , optimal_k)


#plot
plt.plot(range(1,11) , wcss , marker='o')
plt.xlabel("K")
plt.ylabel("wcss values")






from sklearn.metrics import silhouette_score
scores = []

for k in range(2,11):
    kmeans = KMeans(n_clusters=k,random_state = 42)
    labels = kmeans.fit_predict(X_pca)
    score = silhouette_score(X_pca, labels)
    scores.append(score)

#plot
plt.plot(range(2,11) , scores , marker='o')
plt.xlabel("K")
plt.ylabel("silhouette_score")


# as we are using both Elbow method and Silhoutte score to get the correct val of "K" ans we know that they are inversly proportiona
# so we can select the nearest "K" value whre both the graphs are intersecting


# combined plot
k_range = range(2,11)
fig, ax1 = plt.subplots(figsize=(8,6))

ax1.plot(k_range, wcss[:len(k_range)], marker="o", color="blue")
ax1.set_xlabel("K")
ax1.set_ylabel("WCSS")

ax2 =ax1.twinx()
ax2.plot(k_range, scores[:len(k_range)], marker="x", color="red", linestyle="--")
ax2.set_ylabel("Silhoutte_score")





# k_means
kmeans = KMeans(n_clusters =4 , random_state =42)
labels_kmeans = kmeans.fit_predict(X_pca)


# plot 🌟🌟🌟🌟🌟🌟 as we will see to projet in 3D
fig = plt.figure(figsize=(8,6))

ax = fig.add_subplot(111, projection="3d")

ax.scatter( X_pca[:,0] , X_pca[:,1] , X_pca[:,2] , c=labels_kmeans)


# Agglomerative Clustering ( merge 2 closest cluster)
from sklearn.cluster import AgglomerativeClustering



agg_clf = AgglomerativeClustering(n_clusters=4, linkage="ward")
labels_agg = agg_clf.fit_predict(X_pca)


# plot 🌟🌟🌟🌟🌟🌟 as we will see to projet in 3D
fig = plt.figure(figsize=(8,6))
ax = fig.add_subplot(111, projection="3d")
ax.scatter( X_pca[:,0] , X_pca[:,1] , X_pca[:,2] , c=labels_agg)


# we have checked this with DBSCAN it forms around 30+ clusters on its own , so we are not going with that method





X["cluster"] = labels_agg # so we added labels to the cleaned table to put the category
X.head()


# no of cluester segregation
pal=["red" , "blue" , "yellow" , "green"]
sns.countplot(x=df_cleaned["cluster"], palette=pal, hue=X["cluster"])


# Income & Spending patterns
sns.scatterplot(x=X["Total_Spending"], y= X["Income"], hue=X["cluster"], palette=pal)


# Cluster 0 (red) : Low - Moderate income range ; Low-Moderate spending
# Cluster 1 (blue) : High income range ; high spending
# Cluster 2 (yellow) : Low  income range ; Low spending
# Cluster 3 (green) : Moderate-High income ; High spending

# we can create clusters related to various factors also.




# Cluster summary
cluster_summary  = df_cleaned.groupby("cluster").mean()
print(cluster_summary)



