import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler


df = pd.read_csv("thyroid_dataset.csv")


df.head()


#Sandardization
X = df.drop("Outlier_label" , axis=1)
y = df["Outlier_label"]


scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)


X_scaled


from sklearn.ensemble import IsolationForest
clf = IsolationForest(n_estimators=200 , contamination=0.036 , random_state = 42)


labels = clf.fit_predict(X_scaled)


labels


# Visualise
from sklearn.decomposition import PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)


plt.figure(figsize = (8,6))

plt.scatter(X_pca[:,0] ,X_pca[:,1] , c=labels)
plt.xlabel("PC1")
plt.ylabel("PC2")
# in this the purple points are outliers


import numpy as np
n_outliers = np.sum(labels == -1)
n_normal= np.sum(labels  == 1)
print("outliers = ", n_outliers)
print("normal = ", n_normal)






from sklearn.neighbors import LocalOutlierFactor


df = pd.read_csv("thyroid_dataset.csv")

#Sandardization
X = df.drop("Outlier_label" , axis=1)
y = df["Outlier_label"]

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)


neighbs = LocalOutlierFactor() # keeing facotors default

labels = neighbs.fit_predict(X_scaled) # labels ko change kiya 🌟🌟🌟🌟


plt.figure(figsize = (8,6))

plt.scatter(X_pca[:,0] ,X_pca[:,1] , c=labels) # labels apply kiya 🌟🌟🌟
plt.xlabel("PC1")
plt.ylabel("PC2")


n_outliers = np.sum(labels == -1)
n_normal= np.sum(labels  == 1)
print("outliers = ", n_outliers)
print("normal = ", n_normal)



