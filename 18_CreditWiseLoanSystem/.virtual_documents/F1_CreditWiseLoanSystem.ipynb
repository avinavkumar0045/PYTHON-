





import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split


df = pd.read_csv("loan_approval_data.csv")
df.head()
df.info()
df.isnull().sum() # to check the number of null values in each lap
df.describe()


# handle missing values 
categorical_cols = df.select_dtypes(include=["object"]).columns # all the columns with dtype object
numerical_cols = df.select_dtypes(include=["number"]).columns # all the columns with dtype float64

#categorical_cols 

#categorical_cols.size + numerical_cols.size = 20



from sklearn.impute import SimpleImputer
# we are using to fill overall 'mean' to fill the NaN values in numerical colmns
num_imp = SimpleImputer(strategy="mean") 
df[numerical_cols] = num_imp.fit_transform(df[numerical_cols])

# we are using to fill overll "most frequent/occurend" to fill the Nan in the categorical columns
cat_imp = SimpleImputer(strategy="most_frequent")
df[categorical_cols] = cat_imp.fit_transform(df[categorical_cols])
df.head()
df.isnull().sum()





