


import seaborn as sns
import matplotlib.pyplot as plt


sns.set_theme()


sns.get_dataset_names()


tips = sns.load_dataset("tips")
print(type(tips))
print(tips.head())


sns.set_theme(style="darkgrid") #diffww
sns.relplot( #hre in this we dont habe to add the lable and all manually 
    data = tips,
    x = "total_bill",
    y="tip",
    hue="smoker"
)


sns.set_theme(style="darkgrid") #diffww
sns.relplot( #hre in this we dont habe to add the lable and all manually 
    data = tips,
    x = "total_bill",
    y="tip",
    hue="smoker",
    size="size",
    style'smp
)





 #Scatter Plot
tips =sns.load_dataset("tips")
sns.scatterplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="time"
)


 #Line Plot
tips =sns.load_dataset("tips")
sns.lineplot(
    data=tips,
    x="total_bill",
    y="tip",
)


#Line plot example with flights dataset
flights=sns.load_dataset("flights")

sns.lineplot(
    data=flights,
    x="year",
    y="passengers"
)





#BAR PLOTS
print(tips.head()) #let see which gender gives how much tip
sns.barplot(
    data=tips,
    x="day",
    y="tip",
    hue="sex",
)


#box plot
sns.boxplot(
    data=tips,
    x="day",
    y="tip",
)





#Histogram
penguins = sns.load_dataset("penguins")
sns.histplot(
    data = penguins,
    x="body_mass_g",
    bins=30,
)


penguins.head()





#HeatMAPS
flights_pivot = flights.pivot(index="month",columns="year",values="passengers")
sns.heatmap(
    flights_pivot,
    cmap="coolwarm",
    annot=True,# annotation
    fmt ="d" #format to maake the correct widht
)
plt.title("Passengers Heatmap")
plt.tight_layout()


fig,ax = plt.subplots()
sns.lineplot(
    data=tips,
    x="day",
    y="total_bill",
    hue="sex",
    ax=ax,
)



