import gymnasium as gym
import numpy as np
import random


# sam enviroment
env = gym.make("CliffWalking-v1")


print(env.observation_space.n) #states
print(env.action_space.n) # actions

starting_state,_ = env.reset() #36 = 3*12 + 0
print(starting_state) #36





gamma  = 0.99
alpha  = 0.5
episodes = 500
epsilon = 0.1


# Q table => store values
Q = np.zeros((48, 4))





#Policy - epsilon-greedy : state -> action
def epsilon_greedy(state):
    if random.random() < epsilon: ## explore case
        return env.action_space.sample() # radome actions => EXPLORE
    else:
        return np.argmax(Q[state])  # exploit case


for episode in range(episodes):
    # lets see the training path also
    render = (episode% 50  == 0)

    if render: # this if section we have added to visually see the rendering process
        env = gym.make("CliffWalking-v1", render_mode = "human")
        print(f"rendering env for episode={episode+1}/500")
    else:
        env  = gym.make("CliffWalking-v1")

    done = False # when the episodes has ended ( either reached the end or truncate( matlab we dont want to leave it for infinite so we have set time limit)
    state,_ = env.reset()
    action = epsilon_greedy(state) # as SARSA is on-policy algo. , the policy will tell what action to take.

    total_reward = 0
    episode_len = 0

    while not done:
        next_state , reward , terminated, truncated , _ = env.step(action)
        done = terminated or truncated
        next_action = epsilon_greedy(next_state)

        # SARSA update
        Q[state, action] += alpha * (reward + gamma*(Q[next_state , next_action]- Q[state, action] ))

        state = next_state
        action = next_action

        total_reward += reward
        episode_len += 1
        
    print(f"episode = {episode+1}/500:  total reward = {total_reward} & ep length = {episode_len}")
    env.close()


 # so after training , what did our agent learn ?? lets see visually

env =gym.make("CliffWalking-v1", render_mode="human")
state,_= env.reset()
done = False
total_reward = 0
episode_len = 0

while not done:
    action = np.argmax(Q[state])
    state, reward , terminated , truncated,_= env.step(action)
    done = terminated or truncated

    total_reward += reward
    episode_len += 1

print(f"total reward = {total_reward} & episode len = {episode_len}")
env.close()



